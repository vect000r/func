cabal-version:       2.2

name:                ex7
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/vect000r/func#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              vect000r
maintainer:          example@example.com
copyright:           2025 vect000r
category:            Web
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable ex6
  hs-source-dirs:      src
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5
                     , scotty
                     , aeson
                     , text
                     , wai-cors
                     , random
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints

source-repository head
  type:     git
  location: https://github.com/vect000r/func